{
  "coreName": "Ruffle",
  "systemId": "Flash",
  "author": "Ruffle contributors (ruffle-rs/ruffle); chimera core by Sergio Martin",
  "url": "https://github.com/ruffle-rs/ruffle",
  "extensions": {
    ".swf": "Flash"
  },
  "romFile": "game",
  "deterministic": true,
  "memoryLayoutMiB": [
    256,
    16,
    16,
    64,
    512
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. A Rust guest: std's allocator wants a real heap, and a movie's display list and decoded assets live on it.",
  "video": {
    "_comment": "The stage, at scale 1: the live size comes from GetVideoWidth/Height per frame and is whatever the movie declares. Capacity here is the largest stage worth allowing. Drawn by ruffle's own wgpu renderer on a GL context the host owns (waterbox/gl-bridge.h).",
    "width": 1920,
    "height": 1080,
    "getBgra": "GetVideoBgra",
    "vsyncNumerator": 60,
    "vsyncDenominator": 1,
    "_comment_vsync": "A fallback only: a Flash movie carries its own frame rate and the core reports it per movie through GetVsyncNumerator/GetVsyncDenominator."
  },
  "audio": {
    "_comment": "Ruffle's own software mixer, one frame at a time, 44.1 kHz stereo (the same backend shape ruffle's test harness uses). samplesPerFrame is CAPACITY: 44100/fps per frame, and a 1 fps movie is the worst case.",
    "sampleRate": 44100,
    "channels": 2,
    "samplesPerFrame": 44100,
    "get": "GetAudio"
  },
  "input": {
    "name": "Keyboard and Mouse",
    "_comment": "Mouse Left/Middle/Right, then the keyboard. The two axes are the pointer in stage pixels. Buttons are levels; the core turns level changes into Ruffle's key/mouse events at the start of each frame. Wire order is generated by waterbox/input-table.py.",
    "buttons": [
      "Mouse Left Button",
      "Mouse Middle Button",
      "Mouse Right Button",
      "Key A",
      "Key B",
      "Key C",
      "Key D",
      "Key E",
      "Key F",
      "Key G",
      "Key H",
      "Key I",
      "Key J",
      "Key K",
      "Key L",
      "Key M",
      "Key N",
      "Key O",
      "Key P",
      "Key Q",
      "Key R",
      "Key S",
      "Key T",
      "Key U",
      "Key V",
      "Key W",
      "Key X",
      "Key Y",
      "Key Z",
      "Key 1",
      "Key 2",
      "Key 3",
      "Key 4",
      "Key 5",
      "Key 6",
      "Key 7",
      "Key 8",
      "Key 9",
      "Key 0",
      "Key Space",
      "Key Enter",
      "Key Escape",
      "Key Tab",
      "Key Backspace",
      "Key Delete",
      "Key Insert",
      "Key Home",
      "Key End",
      "Key Page Up",
      "Key Page Down",
      "Key Up",
      "Key Down",
      "Key Left",
      "Key Right",
      "Key Left Shift",
      "Key Right Shift",
      "Key Left Control",
      "Key Right Control",
      "Key Left Alt",
      "Key Right Alt",
      "Key Caps Lock",
      "Key Num Lock",
      "Key Scroll Lock",
      "Key Pause",
      "Key F1",
      "Key F2",
      "Key F3",
      "Key F4",
      "Key F5",
      "Key F6",
      "Key F7",
      "Key F8",
      "Key F9",
      "Key F10",
      "Key F11",
      "Key F12",
      "Key Minus",
      "Key Equals",
      "Key Left Bracket",
      "Key Right Bracket",
      "Key Backslash",
      "Key Semicolon",
      "Key Quote",
      "Key Comma",
      "Key Period",
      "Key Slash",
      "Key Backquote",
      "Numpad 0",
      "Numpad 1",
      "Numpad 2",
      "Numpad 3",
      "Numpad 4",
      "Numpad 5",
      "Numpad 6",
      "Numpad 7",
      "Numpad 8",
      "Numpad 9",
      "Numpad Add",
      "Numpad Subtract",
      "Numpad Multiply",
      "Numpad Divide",
      "Numpad Decimal",
      "Numpad Enter"
    ],
    "axes": [
      {
        "name": "Mouse X",
        "min": 0,
        "max": 8191,
        "neutral": 4096
      },
      {
        "name": "Mouse Y",
        "min": 0,
        "max": 8191,
        "neutral": 4096
      }
    ],
    "_comment_axes": "The pointer is normalised across this range and scaled to the movie's own stage inside the core, because a SWF decides its stage size and this file cannot know it. Bound window-relative (WMouse), since the stage is the window."
  },
  "settings": [
    {
      "name": "renderer",
      "display": "Renderer",
      "type": "enum",
      "options": [
        "wgpu-hw"
      ],
      "default": "wgpu-hw",
      "description": "Which renderer draws the picture - and Flash has exactly one here: ruffle's own wgpu renderer, its OpenGL calls leaving the sandbox to your machine's GPU. The suffix -hw is not decoration: it is how the frontend knows to offer a GPU at all, and this core cannot start without one. What it costs: the GPU is outside the sandbox, so it is outside the savestate and different on every machine. The movie's own state stays deterministic - a frame is computed from the display list rather than read back from it - with one exception worth naming, BitmapData.draw(), which rasterises display objects into a bitmap that ActionScript can then read. A movie that leans on that replays faithfully only on the same driver."
    },
    {
      "name": "spoofUrl",
      "display": "Spoofed URL",
      "type": "string",
      "default": "",
      "description": "The address the movie believes it was loaded from. Leave it empty and the movie is loaded as file:///game.swf, which is what a local file is. Many Flash games care: a sponsor lock checks the domain and refuses to start anywhere else, an API call is signed against the page it came from, and relative loads (a level, a soundtrack, a scoreboard) resolve against this address rather than the disk. Set it to the page the game shipped on - for instance https://www.kongregate.com/games/example - and those checks see what they expect. It changes nothing about how the movie is emulated and nothing about determinism: it is one string handed to the player at load, so a movie recorded under one address must be replayed under the same one."
    },
    {
      "name": "pageUrl",
      "display": "Page URL",
      "type": "string",
      "default": "",
      "description": "The address of the web page the movie believes it is embedded in, which is a different question from where the movie itself came from. ActionScript reads it as Security.pageDomain, and a sponsor lock that is not satisfied by the movie's own address often checks this one instead. Leave it empty unless a game refuses to start with Spoofed URL alone; then set both to the same site."
    },
    {
      "name": "playerVersion",
      "display": "Flash Player version",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 32,
      "description": "Which Flash Player the movie is told it is running on. 0 means the version the SWF itself asks for, which is right for almost everything. Raise it when a movie refuses to run on what it detects, and lower it when a movie takes a newer code path that was never finished: content of this age often branches on the player version and the branch that shipped is the one that was tested. It changes what the movie does, so a movie recorded at one version must be replayed at the same one."
    },
    {
      "name": "playerRuntime",
      "display": "Runtime",
      "type": "enum",
      "options": [
        "flashPlayer",
        "air"
      ],
      "default": "flashPlayer",
      "description": "Flash Player or Adobe AIR. AIR is a superset with file and native APIs, and content built for it checks which one it is on. Almost every .swf on the web is Flash Player content; change this only for a movie that was packaged as an AIR application."
    },
    {
      "name": "quality",
      "display": "Rendering quality",
      "type": "enum",
      "options": [
        "low",
        "medium",
        "high",
        "best",
        "high8x8",
        "high8x8linear",
        "high16x16",
        "high16x16linear"
      ],
      "default": "high",
      "description": "How smoothly vector art is drawn - Flash's own Stage.quality, with ruffle's higher settings on top. 'high' is the Flash default and what a movie was authored against. 'low' turns anti-aliasing off, which is faster and is occasionally how a movie was actually seen. The higher entries oversample and cost fill rate. This is the picture only: the movie's own state does not depend on it, and a movie can override it at runtime unless it never asks."
    },
    {
      "name": "loadBehavior",
      "display": "Load behaviour",
      "type": "enum",
      "options": [
        "streaming",
        "delayed",
        "blocking"
      ],
      "default": "streaming",
      "description": "What a movie sees while a SWF it loaded is still arriving. 'streaming' lets the loaded movie start before it is complete and ticks its progress up as it goes, which is what a real player over a real connection does. 'delayed' holds execution until it has all arrived. 'blocking' stops the loader in its tracks until the load finishes, so the movie never observes a partial one. Files here arrive instantly from disk, so this mostly decides whether a preloader animation gets to play at all."
    },
    {
      "name": "compatibilityRules",
      "display": "Ruffle's compatibility rules",
      "type": "bool",
      "default": false,
      "description": "Ruffle ships per-site fixups: rewritten URLs and small behavioural patches that make specific known games work. Ruffle's own players turn them on; this core has always had them off, which is what a preservation run wants - the movie behaves as it was published, and what you record is the movie rather than the movie plus a patch. Turn them on if a known game will not otherwise run. Either way the choice is part of the run: a movie recorded with them on must be replayed with them on."
    },
    {
      "name": "defaultFont",
      "display": "Substitute missing fonts",
      "type": "bool",
      "default": true,
      "description": "Draw text in ruffle's bundled font when the movie asks for a device font it did not embed. With this off, such text does not appear at all - which is what a machine with no matching font installed would have shown, and is occasionally the honest answer, but usually just means missing menus. It affects the picture only."
    },
    {
      "name": "fps",
      "display": "Frame rate",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 1000,
      "description": "How many times a second the machine is stepped, which is how often the input can change. 0 means the movie's own rate, which is what a Flash player runs at and what almost everything wants: one frame here is one frame of the movie. Raise it and the movie still runs at its own rate - the timeline is not sped up and nothing plays faster - but each of its frames is now several frames of yours, so a click, a key or a pointer move can be placed between two of the movie's frames instead of only on them. A game that samples the mouse inside its own frame, or one that drives itself from elapsed time rather than from frames, becomes far easier to steer. What it costs is frames: at twice the rate there are twice as many to draw, twice as many rows in the input log, and twice the file. A multiple of the movie's own rate (30 -> 60, 120) keeps every movie frame landing on the same sub-frame; any other number still works, the movie frames simply fall where they fall. It is part of the machine: a movie recorded at one rate must be replayed at the same one."
    }
  ],
  "firmware": [],
  "precompile": false,
  "_comment_extensions": "Extension -> systemId, the shape the frontend reads. A Flash movie is a .swf and nothing else; anything it loads at runtime arrives through the project's extra files, not by being opened."
}
