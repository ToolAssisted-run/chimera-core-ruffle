    "axes": [
      {
        "name": "Mouse X",
        "min": 0,
        "max": 8191,
        "neutral": 4096,
        "header": "mX"
      },
      {
        "name": "Mouse Y",
        "min": 0,
        "max": 8191,
        "neutral": 4096,
        "header": "mY"
      }
    ],
    "_comment_axes": "The pointer is normalised across this range and scaled to the movie's own stage inside the core, because a SWF decides its stage size and this file cannot know it. Bound window-relative (WMouse), since the stage is the window."
  },
  "settings": [
    {
      "name": "renderer",
      "display": "setting.renderer",
      "type": "enum",
      "options": [
        "software",
        "opengl-hw"
      ],
      "default": "opengl-hw",
      "description": "setting.renderer.about"
    },
    {
      "name": "spoofUrl",
      "display": "setting.spoofurl",
      "type": "string",
      "default": "",
      "description": "setting.spoofurl.about"
    },
    {
      "name": "pageUrl",
      "display": "setting.pageurl",
      "type": "string",
      "default": "",
      "description": "setting.pageurl.about"
    },
    {
      "name": "playerVersion",
      "display": "setting.playerversion",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 32,
      "description": "setting.playerversion.about"
    },
    {
      "name": "playerRuntime",
      "display": "setting.playerruntime",
      "type": "enum",
      "options": [
        "flashPlayer",
        "air"
      ],
      "default": "flashPlayer",
      "description": "setting.playerruntime.about"
    },
    {
      "name": "quality",
      "display": "setting.quality",
      "type": "enum",
      "options": [
        "low",
        "medium",
        "high",
        "best",
        "high8x8",
        "high8x8linear",
        "high16x16",
        "high16x16linear"
      ],
      "default": "high",
      "description": "setting.quality.about"
    },
    {
      "name": "loadBehavior",
      "display": "setting.loadbehavior",
      "type": "enum",
      "options": [
        "streaming",
        "delayed",
        "blocking"
      ],
      "default": "streaming",
      "description": "setting.loadbehavior.about"
    },
    {
      "name": "compatibilityRules",
      "display": "setting.compatibilityrules",
      "type": "bool",
      "default": false,
      "description": "setting.compatibilityrules.about"
    },
    {
      "name": "defaultFont",
      "display": "setting.defaultfont",
      "type": "bool",
      "default": true,
      "description": "setting.defaultfont.about"
    },
    {
      "name": "fps",
      "display": "setting.fps",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 1000,
      "description": "setting.fps.about"
    }
  ],
  "firmware": [],
  "precompile": false,
  "_comment_extensions": "Extension -> systemId, the shape the frontend reads. A Flash movie is a .swf and nothing else; anything it loads at runtime arrives through the project's extra files, not by being opened."
}
