+    /// The shape's own handle. One registered before a backend rebuild names the
+    /// old backend's mesh, so it is registered again from the shape this graphic
+    /// keeps whenever the render epoch has moved.
+    fn render_handle(self, context: &mut RenderContext) -> Option<ShapeHandle> {
+        let shared = self.0.shared.get();
+        let epoch = ruffle_render::render_epoch();
+        let mut slot = shared.render_handle.borrow_mut();
+        match &*slot {
+            Some((ep, handle)) if *ep == epoch => return Some(handle.clone()),
+            None => return None,
+            _ => {}
+        }
+        let library = context.library.library_for_movie(shared.movie.clone())?;
+        let handle = context
+            .renderer
+            .register_shape((&shared.shape).into(), &MovieLibrarySource { library });
+        *slot = Some((epoch, handle.clone()));
+        Some(handle)
+    }
