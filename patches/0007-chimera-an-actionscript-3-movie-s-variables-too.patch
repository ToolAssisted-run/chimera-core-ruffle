+// ---- ActionScript 3 --------------------------------------------------------
+
+/// The place of an ActionScript 3 value that has one.
+fn scalar2(value: &Value2<'_>) -> Option<(Kind, usize, usize, bool)> {
+    match value {
+        Value2::Number(n) => Some((Kind::Number, n as *const f64 as usize, 8, true)),
+        Value2::Integer(i) => Some((Kind::Int, i as *const i32 as usize, 4, true)),
+        Value2::Bool(b) => Some((Kind::Bool, b as *const bool as usize, 1, true)),
+        Value2::String(s) => match s.as_wstr().units() {
+            Units::Bytes(b) if !b.is_empty() => {
+                Some((Kind::Latin1, b.as_ptr() as usize, b.len(), false))
+            }
+            Units::Wide(w) if !w.is_empty() => {
+                Some((Kind::Utf16, w.as_ptr() as usize, w.len() * 2, false))
+            }
+            _ => None,
+        },
+        _ => None,
+    }
+}
