+/// One step of a path in an ActionScript 3 movie: the member of that name.
+fn step2<'gc>(object: Object2<'gc>, name: &WStr) -> Option<(*const Value2<'gc>, bool)> {
+    let base = object.base();
+    let mut found = None;
+    base.chimera_slots(|slot, place, constant| {
+        if slot == name {
+            found = Some((place, constant));
+        }
+        found.is_none()
+    });
+    if found.is_none() {
+        let index = if is_index(name) { name.parse::<u32>().ok() } else { None };
+        base.chimera_dynamic(|key, number, place| {
+            let same = match key {
+                Some(key) => key == name,
+                None => index == Some(number),
+            };
+            if same {
+                found = Some((place, false));
+            }
+            found.is_none()
+        });
+    }
+    found
+}
+
+/// The first object of that name inside another, in the order they are drawn.
+fn child_named2<'gc>(clip: DisplayObject<'gc>, name: &WStr) -> Option<DisplayObject<'gc>> {
+    let container = clip.as_container()?;
+    let mut index = 0;
+    while let Some(child) = container.child_by_index(index) {
+        index += 1;
+        if child.name().is_some_and(|n| n.as_wstr() == name) && child.object2().is_some() {
+            return Some(child);
+        }
+    }
+    None
+}
