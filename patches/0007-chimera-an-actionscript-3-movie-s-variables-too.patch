+    /// chimera: the object's dynamic properties whose name is text or a
+    /// number, to `f`: the text (or none, and the number) and where the value
+    /// is kept.
+    pub fn chimera_dynamic(
+        &self,
+        mut f: impl FnMut(Option<&crate::string::WStr>, u32, *const Value<'gc>) -> bool,
+    ) {
+        let values = self.0.values.borrow();
+        for (key, property) in values.iter() {
+            let more = match key {
+                DynamicKey::String(name) => f(Some(name.as_wstr()), 0, &property.value),
+                DynamicKey::Uint(index) => f(None, *index, &property.value),
+                DynamicKey::Object(_) => true,
+            };
+            if !more {
+                return;
+            }
+        }
+    }
