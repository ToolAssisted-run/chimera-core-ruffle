+impl Path {
+    /// Adds `[n]`.
+    fn push_index(&mut self, index: u32) -> bool {
+        let mut digits = [0u8; 10];
+        let mut n = 0;
+        let mut left = index;
+        loop {
+            digits[n] = b'0' + (left % 10) as u8;
+            n += 1;
+            left /= 10;
+            if left == 0 {
+                break;
+            }
+        }
+        if !self.push_char('[') {
+            return false;
+        }
+        while n > 0 {
+            n -= 1;
+            if !self.push_char(digits[n] as char) {
+                return false;
+            }
+        }
+        self.push_char(']')
+    }
+}
+
+impl Walk<'_> {
+    /// What a variable holds: a place, or an object to go into.
+    fn value2<'gc>(&mut self, value: &Value2<'gc>, constant: bool, depth: usize) {
+        if let Some((kind, addr, len, writable)) = scalar2(value) {
+            self.emit(kind, addr, len, writable && !constant);
+        } else if let Value2::Object(inner) = value {
+            if depth >= MAX_OBJECT_DEPTH {
+                self.complete = false;
+            } else if let Some(clip) = inner.as_display_object() {
+                self.clip2(clip, depth + 1);
+            } else if self.first_visit(inner.as_ptr() as usize) {
+                self.members2(*inner, depth + 1);
+            }
+        }
+    }
+
+    /// An object's slots and its dynamic properties.
+    fn members2<'gc>(&mut self, object: Object2<'gc>, depth: usize) {
+        let base = object.base();
+        base.chimera_slots(|name, place, constant| {
+            let at = self.path.len;
+            if self.path.push_name(name, false) {
+                // SAFETY: a slot lives as long as its object, and nothing runs meanwhile
+                self.value2(unsafe { &*place }, constant, depth);
+            }
+            self.path.len = at;
+            !self.stopped
+        });
+        if self.stopped {
+            return;
+        }
+        base.chimera_dynamic(|name, index, place| {
+            let at = self.path.len;
+            let spelt = match name {
+                Some(name) => self.path.push_name(name, is_index(name)),
+                None => self.path.push_index(index),
+            };
+            if spelt {
+                // SAFETY: the map is borrowed for as long as this runs
+                self.value2(unsafe { &*place }, false, depth);
+            }
+            self.path.len = at;
+            !self.stopped
+        });
+    }
+
+    /// An object on the stage: where it is, what its object holds, and what is
+    /// inside it that no variable led to.
+    fn clip2<'gc>(&mut self, clip: DisplayObject<'gc>, depth: usize) {
+        if self.stopped {
+            return;
+        }
+        let Some(object) = clip.object2() else { return };
+        let object: Object2<'gc> = object.into();
+        if !self.first_visit(object.as_ptr() as usize) {
+            return;
+        }
+        let outer_group = self.group_len;
+        self.group_len = self.path.len;
+
+        let matrix = clip.base().chimera_matrix_place();
+        // SAFETY: only the fields' addresses are taken, nothing is read
+        let (tx, ty) = unsafe {
+            (
+                core::ptr::addr_of!((*matrix).tx) as usize,
+                core::ptr::addr_of!((*matrix).ty) as usize,
+            )
+        };
+        self.builtin("x", Kind::Twips, tx, 4);
+        self.builtin("y", Kind::Twips, ty, 4);
+        if let Some(movie_clip) = clip.as_movie_clip() {
+            let frame = movie_clip.chimera_current_frame_place() as usize;
+            self.builtin("currentFrame", Kind::Frame, frame, 2);
+        }
+
+        self.members2(object, depth);
+
+        if let Some(container) = clip.as_container() {
+            if depth >= MAX_CLIP_DEPTH {
+                self.complete = false;
+            } else {
+                let mut index = 0;
+                while let Some(child) = container.child_by_index(index) {
+                    index += 1;
+                    if self.stopped {
+                        break;
+                    }
+                    let Some(name) = child.name() else { continue };
+                    let at = self.path.len;
+                    if self.path.push_name(name.as_wstr(), false) {
+                        self.clip2(child, depth + 1);
+                    }
+                    self.path.len = at;
+                }
+            }
+        }
+        self.group_len = outer_group;
+    }
+}
