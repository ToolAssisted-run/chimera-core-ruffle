+    /// chimera: every slot the object has a name for, to `f`: the name, where
+    /// the value is kept, and whether it is a constant (chimera_vars). Nothing
+    /// is called and nothing is made; `f` answers whether to go on.
+    pub fn chimera_slots(
+        &self,
+        mut f: impl FnMut(&crate::string::WStr, *const Value<'gc>, bool) -> bool,
+    ) {
+        for (name, _namespace, property) in self.vtable().resolved_traits().iter() {
+            let (id, constant) = match property {
+                Property::Slot { slot_id } => (*slot_id, false),
+                Property::ConstSlot { slot_id } => (*slot_id, true),
+                _ => continue,
+            };
+            if let Some(slot) = self.0.slots.get(id) {
+                if !f(name.as_wstr(), slot.as_ptr() as *const Value<'gc>, constant) {
+                    return;
+                }
+            }
+        }
+    }
