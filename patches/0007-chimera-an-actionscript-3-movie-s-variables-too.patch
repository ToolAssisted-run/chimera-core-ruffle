+/// `find`, for an ActionScript 3 movie: `root`, then members and children.
+fn find2<'gc>(stage: Stage<'gc>, path: &str, sink: &mut dyn FnMut(&Place<'_>)) -> bool {
+    let Some((first, mut at, last)) = next_name(path, 0) else {
+        return false;
+    };
+    if last || first != "root" {
+        return false;
+    }
+    let Some(root) = stage.root_clip() else { return false };
+    let mut clip = Some(root);
+    let mut object: Option<Object2<'gc>> = root.object2().map(Into::into);
+    let mut group_len = first.len();
+    loop {
+        let Some(object_now) = object else { return false };
+        let Some((name, next, is_last)) = next_name(path, at) else {
+            return false;
+        };
+        let name_end = if is_last { path.len() } else { next - usize::from(path.as_bytes()[next - 1] == b'.') };
+
+        let member = with_name(name, |w| step2(object_now, w)).flatten();
+        if let Some((place, constant)) = member {
+            // SAFETY: a slot lives as long as its object, and nothing runs meanwhile
+            let value = unsafe { &*place };
+            if let Some((kind, addr, len, writable)) = scalar2(value) {
+                if !is_last {
+                    return false;
+                }
+                sink(&Place { name: path, group: &path[..group_len], kind, addr, len, writable: writable && !constant });
+                return true;
+            }
+            let Value2::Object(inner) = value else { return false };
+            if is_last {
+                return false;
+            }
+            clip = inner.as_display_object();
+            if clip.is_some() {
+                group_len = name_end;
+            }
+            object = Some(*inner);
+        } else if let Some(c) = clip {
+            if is_last {
+                let matrix = c.base().chimera_matrix_place();
+                // SAFETY: only the fields' addresses are taken
+                let place = unsafe {
+                    match name {
+                        "x" => Some((Kind::Twips, core::ptr::addr_of!((*matrix).tx) as usize, 4)),
+                        "y" => Some((Kind::Twips, core::ptr::addr_of!((*matrix).ty) as usize, 4)),
+                        "currentFrame" => c
+                            .as_movie_clip()
+                            .map(|m| (Kind::Frame, m.chimera_current_frame_place() as usize, 2)),
+                        _ => None,
+                    }
+                };
+                let Some((kind, addr, len)) = place else { return false };
+                sink(&Place { name: path, group: &path[..group_len], kind, addr, len, writable: false });
+                return true;
+            }
+            let Some(child) = with_name(name, |w| child_named2(c, w)).flatten() else {
+                return false;
+            };
+            clip = Some(child);
+            object = child.object2().map(Into::into);
+            group_len = name_end;
+        } else {
+            return false;
+        }
+        at = next;
+    }
+}
