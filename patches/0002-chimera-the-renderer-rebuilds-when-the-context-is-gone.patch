diff --git a/render/src/lib.rs b/render/src/lib.rs
index c3d53d2d3..f313a2fdc 100644
--- a/render/src/lib.rs
+++ b/render/src/lib.rs
@@ -25,3 +25,39 @@ pub mod quality;
 pub mod tessellator;
 
 pub use pixel_bender;
+
+// The render epoch: a counter every GPU-handle cache stamps its entries with.
+//
+// A `RenderBackend`'s GL objects are names a particular context handed out, and
+// a whole-machine savestate carries those names into a session where the
+// context that owned them is gone. When a frontend rebuilds the backend after
+// such a load, every cached `BitmapHandle`/`ShapeHandle` in the object graph
+// still points at the old backend's now-dangling resources. There is no central
+// registry to walk, so instead the frontend BUMPS this epoch, and each cache
+// compares the epoch a handle was made under with the current one: a mismatch
+// means "another backend's object", and the cache re-registers from the source
+// data it still holds (a shape's edges, a bitmap's pixels) rather than drawing
+// nothing.
+//
+// It lives in guest memory, so a savestate carries it like the caches it
+// stamps: a state loaded into the SAME context restores an epoch that still
+// matches, and nothing re-registers. The frontend bumps it only when it has
+// actually rebuilt the backend, which is what keeps this inert on the common
+// path and deterministic on the replayed one.
+use std::sync::atomic::{AtomicU64, Ordering};
+
+// Starts at 1 so that a cache field left at its `0` default always looks stale
+// on first use and registers, without any "never registered" special case.
+static RENDER_EPOCH: AtomicU64 = AtomicU64::new(1);
+
+/// The current render epoch. A cache holding a handle made under a different
+/// epoch must treat it as another backend's and re-register.
+pub fn render_epoch() -> u64 {
+    RENDER_EPOCH.load(Ordering::Relaxed)
+}
+
+/// Advance the render epoch, invalidating every stamped cache. Call this right
+/// after swapping in a freshly built backend, so the next render re-registers.
+pub fn bump_render_epoch() -> u64 {
+    RENDER_EPOCH.fetch_add(1, Ordering::Relaxed) + 1
+}
