+/// GPU objects that the backend which made them can drop before the handle
+/// holding them goes.
+///
+/// Every wgpu object keeps its device alive, and with it everything the device
+/// owns. When a savestate is loaded into a new GL context, the core builds a
+/// new backend and drops the old one, but ruffle_core lets go of its old
+/// handles only when it next draws them: a shape not drawn since, or a
+/// BitmapData that is garbage the collector has not reached yet, kept the old
+/// device and its resources. Corporate Climber with a rebuild before each of
+/// 600 frames ended with 207 old devices alive and 35 MB more guest memory,
+/// and a long TAStudio session of loads ran the guest out of memory at frame
+/// 48775. So a backend that is dropped takes back the GPU objects of every
+/// handle it issued (`Issued` in backend.rs), and a handle that outlives it
+/// is an empty shell until its holder registers it again.
+///
+/// Nothing reaches a released handle: every cache in ruffle_core compares the
+/// render epoch first and re-registers. A use that slips past that check
+/// panics with the message below, rather than draw with another backend's
+/// objects.
+pub(crate) struct Releasable<T>(std::cell::UnsafeCell<Option<T>>);
+
+impl<T> Releasable<T> {
+    pub(crate) fn new(value: T) -> Self {
+        Releasable(std::cell::UnsafeCell::new(Some(value)))
+    }
+
+    pub(crate) fn get(&self) -> &T {
+        // Safety: `release` is the only writer, and its caller promises no
+        // reference from here is alive.
+        unsafe { (*self.0.get()).as_ref() }
+            .expect("a GPU object was used after the renderer that made it was replaced")
+    }
+
+    /// Safety: no reference returned by `get` may be alive. The backend calls
+    /// this only while it is being dropped, between frames.
+    pub(crate) unsafe fn release(&self) {
+        drop(unsafe { (*self.0.get()).take() });
+    }
+}
+
+impl<T: std::fmt::Debug> std::fmt::Debug for Releasable<T> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match unsafe { (*self.0.get()).as_ref() } {
+            Some(value) => value.fmt(f),
+            None => f.write_str("(released)"),
+        }
+    }
+}
