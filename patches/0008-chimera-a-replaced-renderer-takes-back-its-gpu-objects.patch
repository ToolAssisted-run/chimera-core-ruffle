+/// Every texture and mesh this backend handed out, held weakly, so that
+/// dropping the backend can take back their GPU objects (see `Releasable` in
+/// lib.rs). The dead entries are pruned whenever the list has doubled, so it
+/// stays within twice the handles alive.
+#[derive(Default)]
+struct Issued {
+    textures: Vec<Weak<Texture>>,
+    meshes: Vec<Weak<Mesh>>,
+    prune_at: usize,
+}
+
+impl Issued {
+    fn texture(&mut self, texture: Texture) -> BitmapHandle {
+        let texture = Arc::new(texture);
+        self.textures.push(Arc::downgrade(&texture));
+        self.prune();
+        BitmapHandle(texture)
+    }
+
+    fn mesh(&mut self, mesh: Mesh) -> ShapeHandle {
+        let mesh = Arc::new(mesh);
+        self.meshes.push(Arc::downgrade(&mesh));
+        self.prune();
+        ShapeHandle(mesh)
+    }
+
+    fn prune(&mut self) {
+        if self.textures.len() + self.meshes.len() < self.prune_at {
+            return;
+        }
+        self.textures.retain(|t| t.strong_count() > 0);
+        self.meshes.retain(|m| m.strong_count() > 0);
+        self.prune_at = 2 * (self.textures.len() + self.meshes.len()).max(256);
+    }
+}
+
+impl<T: RenderTarget> Drop for WgpuRenderBackend<T> {
+    fn drop(&mut self) {
+        // Between frames: nothing holds a reference into these.
+        for texture in self.issued.textures.drain(..) {
+            if let Some(texture) = texture.upgrade() {
+                unsafe { texture.release() };
+            }
+        }
+        for mesh in self.issued.meshes.drain(..) {
+            if let Some(mesh) = mesh.upgrade() {
+                unsafe { mesh.release() };
+            }
+        }
+    }
 }
 
