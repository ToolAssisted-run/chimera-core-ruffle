@@ -81,6 +81,30 @@ impl TessellationCache {
         best_index.map(|index| self.touch_entry(index))
     }
 
+    /// Empties a cache tessellated under another render epoch and returns the
+    /// scales it held, least recently used first; `None` when it is current.
+    ///
+    /// The caller tessellates those same scales again onto the rebuilt backend
+    /// and inserts them in this order, so the cache comes back exactly as it
+    /// was. Emptying it instead is not neutral: `find_near_and_touch` answers
+    /// with the NEAREST cached scale, so a run whose cache was emptied draws a
+    /// shape tessellated at this frame's scale where a run that never rebuilt
+    /// draws the one cached frames earlier - edge pixels that differ after a
+    /// rewind and stay different until the cache happens to turn over.
+    pub(crate) fn take_stale_scales(&mut self, epoch: u64) -> Option<Vec<f32>> {
+        if self.epoch == epoch {
+            return None;
+        }
+        let scales = self.entries[..self.len]
+            .iter()
+            .filter_map(|entry| entry.as_ref().map(|(scale, _)| *scale))
+            .collect();
+        self.entries = std::array::from_fn(|_| None);
+        self.len = 0;
+        self.epoch = epoch;
+        Some(scales)
+    }
+
     /// Inserts a new cached shape handle with the given scale.
     ///
     /// If the cache is full, the least recently used entry will be evicted to make room for the new entry.
